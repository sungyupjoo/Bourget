<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+. Only Bourget's settings file (rules, popup text) is ever included, and only while
  the user has turned backup on in Bourget's settings (BourgetBackupAgent decides that).
  Cloud backups are made only when they can be end-to-end encrypted (a screen lock is set).
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
